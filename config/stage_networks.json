            "low": 25,
            "high": 100,
            "log": true
          }
        ]
      },
      "default": {
        "lr": 0.0005,
        "weight_decay": 0.0001,
        "dropout": 0.2,
        "filter_maps": 50
      }
    }
  ],
  "network": {
    "device": "cuda",
    "epochs": 20,
    "batch_size": 16,
    "max_words": 4000,
    "warmup_steps": 2000,
