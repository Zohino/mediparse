    {
      "family": "multirescnn",
      "space": {
        "params": [
          {
            "kind": "float",
            "name": "lr",
            "low": 0.0001,
            "high": 0.005,
            "log": true
          },
          {
            "kind": "float",
            "name": "weight_decay",
            "low": 1e-06,
            "high": 0.01,
