        "params": [
          {
            "kind": "float",
            "name": "lr",
            "low": 0.01,
            "high": 5.0,
            "log": true
          },
          {
            "kind": "int",
            "name": "epoch",
            "low": 5,
            "high": 100,
            "log": true
          },
          {
            "kind": "int",
            "name": "word_ngrams",
            "low": 1,
            "high": 2,
            "log": false
          },
          {
            "kind": "int",
            "name": "dim",
            "low": 10,
            "high": 100,
            "log": true
          }
        ]
      },
      "default": {
        "lr": 0.1,
        "epoch": 5,
        "word_ngrams": 1,
        "dim": 100
