from pathlib import Path

from mediparse.entrypoints.workflow_code import code_fingerprint

SYNTHETIC = Path("resources/synthetic")
SMOKETEST = Path("build/smoketest")
SMOKETEST_LOGS = Path("logs/smoketest")


rule smoketest:
    input:
        metrics=SMOKETEST / "metrics.parquet",
        inference=SMOKETEST / "inference.parquet",
        cohort=SMOKETEST / "cohort.parquet",
    params:
        code=code_fingerprint("workflow/scripts/smoketest_summary.py"),
        corpus=SYNTHETIC,
        outputs=SMOKETEST,
        logs=SMOKETEST_LOGS,
    script:
        "scripts/smoketest_summary.py"


include: "rules/cohort.smk"
include: "rules/download.smk"
include: "rules/experiment.smk"
include: "rules/smoketest.smk"
